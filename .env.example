# Copy to .env and fill in. NEVER commit .env (it's gitignored).
# Generate the three random secrets with:  npm run gen:secrets

# Where the app runs. Local: http://localhost:3000   Production: https://<your-app>.vercel.app
APP_URL=http://localhost:3000

# Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random secrets (npm run gen:secrets)
SESSION_SECRET=
TOKEN_ENCRYPTION_KEYS=
CRON_SECRET=

# Who may sign in, and which mailboxes may be connected
ALLOWED_EMAILS=you@example.com
PRIMARY_EMAIL=you@example.com
CONNECTABLE_EMAILS=you@example.com,student@school.example.org

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
# Leave empty during local development to use the built-in local database (.data/pglite).
DATABASE_URL=

# Anthropic Console → API Keys (Phase 5). You paste this yourself.
ANTHROPIC_API_KEY=

# Blackbaud "Share calendar" Feed URL (Phase 4). Treat it like a password.
BLACKBAUD_ICS_URL=

# 1 = show fake demo data (development only; refused in production)
DEMO_MODE=
